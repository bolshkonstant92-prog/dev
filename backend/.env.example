NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_dashboard
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend
FRONTEND_URL=http://localhost:5173

# 1C Integration
OLE_DB_CONNECTION_STRING=Provider=MSOLEDBSQL;Data Source=SERVER;User ID=admin;Password=password
SOAP_URL=http://1c-server:8080/ws
SYNC_INTERVAL=30

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Logging
LOG_LEVEL=debug
